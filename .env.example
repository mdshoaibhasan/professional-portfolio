# Copy to .env in the REPOSITORY ROOT (read by backend/config/settings/base.py) and to frontend/.env.local
# (frontend), then fill in real values.
# NEVER commit real .env files. Values below are placeholders only.

# ── Django core ─────────────────────────────────────
# DJANGO_SETTINGS_MODULE has no effect here: .env is read after Django picks its settings module.
# Set it in the real environment instead (manage.py defaults to dev, wsgi.py to prod).
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Non-default admin path (no leading/trailing slash). Production refuses "admin" or anything containing "change-me".
DJANGO_ADMIN_PATH=manage-change-me

# Production HTTPS (config/settings/prod.py)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_TLS_PROXY=False
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Public API throttle for anonymous visitors
API_ANON_RATE=120/minute
# Number of trusted reverse proxies in front of Django (0 = use the connection address)
API_NUM_PROXIES=0

# ── Database ────────────────────────────────────────
# SQLite file path (relative to backend/ or absolute on the server)
SQLITE_PATH=db.sqlite3
# Uploaded images (profile photo, project covers); defaults to backend/media
MEDIA_ROOT=

# ── Email (inquiry notifications) ───────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
INQUIRY_NOTIFY_EMAIL=

# ── Inquiry protection ──────────────────────────────
# The Privacy Policy states IPs are held for up to one hour — update it if you change the period.
INQUIRY_RATE_LIMIT=5/hour
INQUIRY_MIN_SUBMIT_SECONDS=3
# How long a loaded contact form stays valid (seconds)
INQUIRY_TOKEN_MAX_AGE_SECONDS=86400
# Days to keep inquiries / spam before `manage.py purge_inquiries` deletes them.
# Leave empty to keep everything. Must match the period stated in the Privacy Policy.
INQUIRY_RETENTION_DAYS=
INQUIRY_SPAM_RETENTION_DAYS=

# ── Admin sign-in rate limiting (per IP) ────────────
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900

# ── Site / SEO ──────────────────────────────────────
# Public address used for canonical URLs, Open Graph tags and the sitemap. Production requires https:// and a
# real domain, and refuses to start otherwise.
SITE_URL=http://localhost:5173
# Built frontend that Django serves with per-page <head> tags (defaults to frontend/dist).
FRONTEND_DIST_DIR=

# ── Frontend (Vite exposes only VITE_* variables; they are PUBLIC — no secrets here) ──
VITE_API_BASE_URL=/api/v1

# ── Analytics / ads (D-039). Empty = nothing loads and no cookie banner is shown. Set at BUILD time. ──
# Each one set here appears in the cookie banner and Privacy Policy and loads only after consent.
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_ID=
