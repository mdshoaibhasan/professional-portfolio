# Copy to .env (backend) and frontend/.env.local (frontend) and fill in real values.
# NEVER commit real .env files. Values below are placeholders only.

# ── Django core ─────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Non-default admin path (no leading/trailing slash). Production refuses "admin" or anything containing "change-me".
DJANGO_ADMIN_PATH=manage-change-me

# Production HTTPS (config/settings/prod.py)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_TLS_PROXY=False
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Public API throttle for anonymous visitors
API_ANON_RATE=120/minute

# ── Database ────────────────────────────────────────
# SQLite file path (relative to backend/ or absolute on the server)
SQLITE_PATH=db.sqlite3
# Uploaded images (profile photo, project covers); defaults to backend/media
MEDIA_ROOT=

# ── Email (inquiry notifications) ───────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
INQUIRY_NOTIFY_EMAIL=

# ── Inquiry protection ──────────────────────────────
INQUIRY_RATE_LIMIT=5/hour
INQUIRY_MIN_SUBMIT_SECONDS=3

# ── Site ────────────────────────────────────────────
SITE_URL=http://localhost:5173

# ── Frontend (Vite exposes only VITE_* variables; they are PUBLIC — no secrets here) ──
VITE_API_BASE_URL=/api/v1
VITE_SITE_URL=http://localhost:5173

# ── Analytics / ads (Milestone 8; leave empty until consent system is approved) ──
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_ID=
